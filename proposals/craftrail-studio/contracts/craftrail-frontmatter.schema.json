{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:craftrail:schema:frontmatter:1",
  "title": "CraftRail front-matter profile v1",
  "description": "Per-file metadata for CraftRail Markdown artifacts. The YAML subset grammar is defined in the CraftRail Studio spec; this schema constrains keys and value types after parsing.",
  "type": "object",
  "required": ["craftrail", "type"],
  "additionalProperties": false,
  "patternProperties": {
    "^x_[a-z0-9_]+$": {
      "description": "Extension keys. Ignored by CraftRail tools, preserved on edit.",
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/scalar" } }
      ]
    }
  },
  "properties": {
    "craftrail": { "const": 1, "description": "Profile version." },
    "type": {
      "enum": ["feature", "plan", "tasks", "verification", "adr", "register", "brief", "architecture", "other"]
    },
    "id": {
      "type": "string",
      "description": "Feature number (\"003\") for feature files; ADR ID (\"ADR-004\") for ADRs; omitted otherwise.",
      "pattern": "^([0-9]{3,}|ADR-[0-9]{3,})$"
    },
    "feature": {
      "type": "string",
      "pattern": "^[0-9]{3,}$",
      "description": "Owning feature number for plan, tasks and verification files. Must match the folder number."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
    "owner": { "type": "string", "minLength": 1, "maxLength": 120 },
    "created": { "$ref": "#/$defs/date" },
    "updated": { "$ref": "#/$defs/date" },
    "approved_by": { "type": "string", "minLength": 1, "maxLength": 120 },
    "approved_on": { "$ref": "#/$defs/date" },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 40 }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ADR-[0-9]{3,}$" }
    },
    "superseded_by": { "type": "string", "pattern": "^ADR-[0-9]{3,}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "feature" } } },
      "then": {
        "required": ["id", "title", "status", "owner", "created"],
        "properties": {
          "status": { "enum": ["draft", "proposed", "approved", "in-progress", "verified", "deferred", "deprecated"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "adr" } } },
      "then": {
        "required": ["id", "title", "status", "created"],
        "properties": {
          "status": { "enum": ["proposed", "accepted", "rejected", "deprecated", "superseded"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["plan", "tasks", "verification"] } } },
      "then": { "required": ["feature"] }
    },
    {
      "if": {
        "anyOf": [
          { "properties": { "type": { "const": "feature" }, "status": { "enum": ["approved", "in-progress", "verified"] } }, "required": ["status"] },
          { "properties": { "type": { "const": "adr" }, "status": { "const": "accepted" } }, "required": ["status"] }
        ]
      },
      "then": { "required": ["approved_by", "approved_on"] }
    },
    {
      "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
      "then": { "required": ["superseded_by"] }
    }
  ],
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "scalar": { "type": ["string", "integer", "boolean"] },
    "reference": {
      "type": "string",
      "description": "Project-wide ID (FR-012, ADR-004) or feature-qualified local ID (003:TASK-002).",
      "pattern": "^(([0-9]{3,}:)?(AC|TASK|TEST)-[0-9]{3,}|(BR|FR|NFR|CON|US|ADR)-[0-9]{3,})$"
    }
  }
}
